class _SettingsPageState extends State<SettingsPage> {
  double scale = 1.0;

  @override
  void initState() {
    super.initState();
    scale = uiScaleNotifier.value;
  }

  Future<void> _setScale(double value) async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setDouble('ui_scale', value);
    uiScaleNotifier.value = value;
    setState(() => scale = value);
  }

  Future<void> _editAccount() async {
    await Navigator.push(
      context,
      MaterialPageRoute(builder: (_) => const EditAccountPage()),
    );
  }

  Future<void> _logout() async {
    final ok = await showDialog<bool>(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('ØªØ³Ø¬ÙŠÙ„ Ø§Ù„Ø®Ø±ÙˆØ¬'),
        content: const Text('Ù‡Ù„ ØªØ±ÙŠØ¯ ØªØ³Ø¬ÙŠÙ„ Ø§Ù„Ø®Ø±ÙˆØ¬ Ù…Ù† Ø§Ù„Ø­Ø³Ø§Ø¨ØŸ'),
        actions: [
          TextButton(onPressed: () => Navigator.pop(context, false), child: const Text('Ø¥Ù„ØºØ§Ø¡')),
          FilledButton(onPressed: () => Navigator.pop(context, true), child: const Text('Ø®Ø±ÙˆØ¬')),
