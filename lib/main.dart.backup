                      color: isUser
                          ? Colors.white
                          : Colors.black87,
                      height: 1.5,
                      fontSize: 15,
                    ),
                  ),
              ],
            ),
          ),
        ),

        if (!isUser && index > 0)
          _assistantActions(message.text),
      ],
    );
  }

