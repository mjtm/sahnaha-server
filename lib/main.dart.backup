class GradesPage extends StatefulWidget {
  const GradesPage({super.key});

  @override
  State<GradesPage> createState() => _GradesPageState();
}

class _GradesPageState extends State<GradesPage> {
  static const String _storageKey = 'student_grades';

  List<String> subjects = [];
  Map<String, double> grades = {};
  bool loading = true;

  @override
  void initState() {
    super.initState();
    _loadGrades();
  }

  Future<void> _loadGrades() async {
    final prefs = await SharedPreferences.getInstance();
    final gradeName = prefs.getString('student_grade') ?? '';

    final loaded = <String, double>{};
    final saved = prefs.getString(_storageKey);

    if (saved != null && saved.isNotEmpty) {
      try {
        final decoded = jsonDecode(saved);

        if (decoded is Map) {
          decoded.forEach((key, value) {
            if (key is String && value is num) {
              loaded[key] = value.toDouble();
            }
          });
        }
      } catch (_) {}
    }

    if (!mounted) return;

    setState(() {
      subjects = List<String>.from(
        subjectsByGrade[gradeName] ?? const <String>[],
      );
      grades = loaded;
      loading = false;
    });
  }

  Future<void> _saveGrades() async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString(_storageKey, jsonEncode(grades));
  }

  double get average {
    if (grades.isEmpty) return 0;

    final total = grades.values.fold<double>(
      0,
          (sum, value) => sum + value,
    );

    return total / grades.length;
  }

  String _resultText(double value) {
    if (value >= 90) return 'Ù…Ù…ØªØ§Ø²';
    if (value >= 80) return 'Ø¬ÙŠØ¯ Ø¬Ø¯Ø§Ù‹';
    if (value >= 70) return 'Ø¬ÙŠØ¯';
    if (value >= 50) return 'Ù…Ù‚Ø¨ÙˆÙ„';
    return 'ÙŠØ­ØªØ§Ø¬ Ù…Ø±Ø§Ø¬Ø¹Ø©';
  }

  Future<void> _editGrade(String subject) async {
    final result = await showDialog<double>(
      context: context,
      builder: (_) => _GradeDialog(
        subject: subject,
        currentGrade: grades[subject],
      ),
    );

    if (result == null) return;

    setState(() {
      grades[subject] = result;
    });

    await _saveGrades();
  }

  Future<void> _deleteGrade(String subject) async {
    setState(() {
      grades.remove(subject);
    });

    await _saveGrades();
  }

  Widget _summaryCard() {
    final averageValue = average;

    return Container(
      margin: const EdgeInsets.fromLTRB(18, 18, 18, 16),
      padding: const EdgeInsets.all(20),
      decoration: BoxDecoration(
        gradient: const LinearGradient(
          colors: [
            Color(0xFFDB2777),
            Color(0xFFBE185D),
          ],
        ),
        borderRadius: BorderRadius.circular(24),
      ),
      child: Column(
        children: [
          const Text(
            'Ù…Ø¹Ø¯Ù„ÙŠ Ø§Ù„Ø­Ø§Ù„ÙŠ',
            style: TextStyle(
              color: Colors.white70,
              fontSize: 15,
            ),
          ),
          const SizedBox(height: 5),
          Text(
            grades.isEmpty
                ? 'â€”'
                : '${averageValue.toStringAsFixed(1)} / 100',
            style: const TextStyle(
              color: Colors.white,
              fontSize: 32,
              fontWeight: FontWeight.bold,
            ),
          ),
          if (grades.isNotEmpty) ...[
            const SizedBox(height: 5),
            Text(
              _resultText(averageValue),
              style: const TextStyle(
                color: Colors.white,
                fontSize: 16,
                fontWeight: FontWeight.bold,
              ),
            ),
          ],
          const SizedBox(height: 16),
          Row(
            children: [
              Expanded(
                child: _SummaryMini(
                  title: 'Ø§Ù„Ù…ÙˆØ§Ø¯',
                  value: '${grades.length}/${subjects.length}',
                ),
              ),
              const SizedBox(width: 10),
              Expanded(
                child: _SummaryMini(
                  title: 'Ø£Ø¹Ù„Ù‰ Ø¯Ø±Ø¬Ø©',
                  value: grades.isEmpty
                      ? 'â€”'
                      : grades.values
                      .reduce((a, b) => a > b ? a : b)
                      .toStringAsFixed(0),
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }

  Widget _subjectCard(String subject) {
    final value = grades[subject];
    final hasGrade = value != null;

    return Card(
      margin: const EdgeInsets.only(bottom: 12),
      elevation: 0,
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(18),
        side: const BorderSide(
          color: Color(0xFFE2E8F0),
        ),
      ),
      child: InkWell(
        borderRadius: BorderRadius.circular(18),
        onTap: () => _editGrade(subject),
        child: Padding(
          padding: const EdgeInsets.all(15),
          child: Row(
            children: [
              Container(
                width: 50,
                height: 50,
                decoration: BoxDecoration(
                  color: hasGrade
                      ? const Color(0xFFFCE7F3)
                      : const Color(0xFFF1F5F9),
                  shape: BoxShape.circle,
                ),
                child: Icon(
                  Icons.menu_book_rounded,
                  color: hasGrade
                      ? const Color(0xFFDB2777)
                      : Colors.grey,
                ),
              ),
              const SizedBox(width: 13),
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      subject,
                      style: const TextStyle(
                        fontSize: 17,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    const SizedBox(height: 4),
                    Text(
                      hasGrade
                          ? _resultText(value!)
                          : 'Ø§Ø¶ØºØ· Ù„Ø¥Ø¶Ø§ÙØ© Ø§Ù„Ø¯Ø±Ø¬Ø©',
                      style: TextStyle(
                        color: hasGrade
                            ? const Color(0xFFDB2777)
                            : Colors.grey,
                        fontSize: 13,
