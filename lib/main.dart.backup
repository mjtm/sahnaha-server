class AssistantPage extends StatefulWidget {
  const AssistantPage({super.key});

  @override
  State<AssistantPage> createState() => _AssistantPageState();
}

class _AssistantMessage {
  final String text;
  final bool isUser;
  final Uint8List? imageBytes;

  const _AssistantMessage({
    required this.text,
    required this.isUser,
    this.imageBytes,
  });
}

class _AssistantPageState extends State<AssistantPage> {
  final controller = TextEditingController();
  final scrollController = ScrollController();
  final ImagePicker picker = ImagePicker();

  final messages = <_AssistantMessage>[
    const _AssistantMessage(
      text: 'Ø£Ù‡Ù„Ø§Ù‹ Ø¨Ùƒ ðŸ‘‹ Ø£Ù†Ø§ Ù…Ø³Ø§Ø¹Ø¯Ùƒ Ø§Ù„Ø¯Ø±Ø§Ø³ÙŠ. ØµÙˆÙ‘Ø± ÙˆØ§Ø¬Ø¨Ùƒ Ø£Ùˆ Ø§ÙƒØªØ¨ Ø³Ø¤Ø§Ù„Ùƒ ÙˆØ£Ù†Ø§ Ø£Ø³Ø§Ø¹Ø¯Ùƒ Ø®Ø·ÙˆØ© Ø¨Ø®Ø·ÙˆØ©.',
      isUser: false,
    ),
  ];

  bool sending = false;

  Uint8List? selectedImageBytes;
  String? selectedImageMimeType;

  static const String serverUrl =
      'https://sahnaha-server.vercel.app/api/chat';

  @override
  void dispose() {
    controller.dispose();
    scrollController.dispose();
    super.dispose();
  }

  // ============================================================
  // Ø§Ø®ØªÙŠØ§Ø± ØµÙˆØ±Ø© Ù…Ù† Ø§Ù„Ù…Ø¹Ø±Ø¶
  // ============================================================

  Future<void> pickFromGallery() async {
    if (sending) return;

    try {
      final XFile? file = await picker.pickImage(
        source: ImageSource.gallery,
        imageQuality: 75,
        maxWidth: 1600,
        maxHeight: 1600,
      );

      if (file == null) return;

      final bytes = await file.readAsBytes();

      if (!mounted) return;

      setState(() {
        selectedImageBytes = bytes;
        selectedImageMimeType = _getMimeType(file);
      });
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('ØªØ¹Ø°Ø± Ø§Ø®ØªÙŠØ§Ø± Ø§Ù„ØµÙˆØ±Ø©'),
        ),
      );
    }
  }

  // ============================================================
  // Ø§Ù„ÙƒØ§Ù…ÙŠØ±Ø§
  // ============================================================

  Future<void> takePhoto() async {
    if (sending) return;

    try {
      final XFile? file = await picker.pickImage(
        source: ImageSource.camera,
        imageQuality: 75,
        maxWidth: 1600,
        maxHeight: 1600,
      );

      if (file == null) return;

      final bytes = await file.readAsBytes();

      if (!mounted) return;

      setState(() {
        selectedImageBytes = bytes;
        selectedImageMimeType = _getMimeType(file);
      });
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('ØªØ¹Ø°Ø± ÙØªØ­ Ø§Ù„ÙƒØ§Ù…ÙŠØ±Ø§'),
        ),
      );
    }
  }

  String _getMimeType(XFile file) {
    final mime = file.mimeType;

    if (mime != null && mime.isNotEmpty) {
      return mime;
    }

    final path = file.path.toLowerCase();

    if (path.endsWith('.png')) {
      return 'image/png';
    }

    if (path.endsWith('.webp')) {
      return 'image/webp';
    }

    return 'image/jpeg';
  }

  void removeSelectedImage() {
    if (sending) return;

    setState(() {
      selectedImageBytes = null;
      selectedImageMimeType = null;
    });
  }

  // ============================================================
  // Ø¥Ø±Ø³Ø§Ù„ Ø§Ù„Ø³Ø¤Ø§Ù„ / Ø§Ù„ØµÙˆØ±Ø©
  // ============================================================

  Future<void> send({
    String? customPrompt,
  }) async {
    final typedText = controller.text.trim();
    final text = customPrompt ?? typedText;

    if ((text.isEmpty && selectedImageBytes == null) || sending) {
      return;
    }

    final imageBytes = selectedImageBytes;
    final imageMimeType = selectedImageMimeType ?? 'image/jpeg';

    final imageBase64 =
    imageBytes != null ? base64Encode(imageBytes) : null;

    final userText = text.isEmpty
        ? 'Ø­Ù„ Ù‡Ø§ÙŠ Ø§Ù„ØµÙˆØ±Ø© ÙˆØ§Ø´Ø±Ø­Ù„ÙŠ Ø§Ù„Ø­Ù„ Ø®Ø·ÙˆØ© Ø¨Ø®Ø·ÙˆØ©.'
        : text;

    controller.clear();

    setState(() {
      messages.add(
        _AssistantMessage(
          text: userText,
          isUser: true,
          imageBytes: imageBytes,
        ),
      );

      selectedImageBytes = null;
      selectedImageMimeType = null;
      sending = true;
    });

    _scrollToBottom();

    try {
      final prefs = await SharedPreferences.getInstance();

      final studentName =
          prefs.getString('student_name') ?? 'Ø§Ù„Ø·Ø§Ù„Ø¨';

      final studentGrade =
          prefs.getString('student_grade') ?? 'ØºÙŠØ± Ù…Ø­Ø¯Ø¯';

      final response = await http
          .post(
        Uri.parse(serverUrl),
        headers: {
          'Content-Type': 'application/json',
        },
        body: jsonEncode({
          'message': text,
          'studentName': studentName,
          'studentGrade': studentGrade,
          'image': imageBase64,
          'imageMimeType': imageMimeType,
        }),
      )
          .timeout(
        const Duration(seconds: 60),
      );

      if (!mounted) return;

      if (response.statusCode == 200) {
        final data = jsonDecode(response.body);

        final answer = data['answer']?.toString();

        if (data['success'] == true &&
            answer != null &&
            answer.isNotEmpty) {
          setState(() {
            messages.add(
              _AssistantMessage(
                text: answer,
                isUser: false,
              ),
            );
          });
        } else {
          setState(() {
            messages.add(
              const _AssistantMessage(
                text: 'Ø¹Ø°Ø±Ø§Ù‹ØŒ Ø§Ù„Ù…Ø³Ø§Ø¹Ø¯ Ù…Ø§ Ù‚Ø¯Ø± ÙŠØ·Ù„Ø¹ Ø¬ÙˆØ§Ø¨ Ø­Ø§Ù„ÙŠØ§Ù‹.',
                isUser: false,
              ),
            );
          });
        }
      } else {
        String errorText = 'ØªØ¹Ø°Ø± Ø§Ù„Ø§ØªØµØ§Ù„ Ø¨Ø§Ù„Ù…Ø³Ø§Ø¹Ø¯.\nØ±Ù…Ø² Ø§Ù„Ø®Ø·Ø£: ${response.statusCode}';

        try {
          final data = jsonDecode(response.body);
          final serverError = data['error']?.toString();

          if (serverError != null && serverError.isNotEmpty) {
            errorText = 'ØªØ¹Ø°Ø± Ø§Ù„Ø§ØªØµØ§Ù„ Ø¨Ø§Ù„Ù…Ø³Ø§Ø¹Ø¯.\n$serverError';
          }
        } catch (_) {}

        setState(() {
          messages.add(
            _AssistantMessage(
              text: errorText,
              isUser: false,
            ),
          );
        });
      }
    } catch (e) {
      if (!mounted) return;

      setState(() {
        messages.add(
          const _AssistantMessage(
            text:
            'Ù…Ø§ Ù‚Ø¯Ø±Øª Ø£ØªØµÙ„ Ø¨Ø§Ù„Ø³ÙŠØ±ÙØ± ðŸ¤–\n\n'
                'ØªØ£ÙƒØ¯ Ù…Ù† Ø§ØªØµØ§Ù„ Ø§Ù„Ø¥Ù†ØªØ±Ù†Øª ÙˆØ­Ø§ÙˆÙ„ Ù…Ø±Ø© Ø«Ø§Ù†ÙŠØ©.',
            isUser: false,
          ),
        );
      });
    } finally {
      if (mounted) {
        setState(() {
          sending = false;
        });

        _scrollToBottom();
      }
    }
  }

  // ============================================================
  // Ø£ÙˆØ§Ù…Ø± Ø§Ù„Ù…Ø³Ø§Ø¹Ø¯
  // ============================================================

  Future<void> repeatExplanation(String answer) async {
