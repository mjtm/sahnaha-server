class HomeworkPage extends StatefulWidget {
  const HomeworkPage({super.key});

  @override
  State<HomeworkPage> createState() => _HomeworkPageState();
}

class _HomeworkPageState extends State<HomeworkPage> {
  static const String _storageKey = 'student_homeworks';

  List<_HomeworkData> homeworks = [];
  bool loading = true;

  @override
  void initState() {
    super.initState();
    _loadHomeworks();
  }

  Future<void> _loadHomeworks() async {
    final prefs = await SharedPreferences.getInstance();
    final saved = prefs.getStringList(_storageKey) ?? [];
    final loaded = <_HomeworkData>[];

    for (final item in saved) {
      final parts = item.split('|');
      if (parts.length >= 5) {
        loaded.add(_HomeworkData(
          subject: parts[0],
          title: parts[1],
          dueDate: parts[2],
          completed: parts[3] == 'true',
          id: parts[4],
        ));
      }
    }

    if (!mounted) return;
    setState(() {
      homeworks = loaded;
      loading = false;
    });
  }

  Future<void> _saveHomeworks() async {
    final prefs = await SharedPreferences.getInstance();
    final saved = homeworks.map((item) =>
    '${item.subject}|${item.title}|${item.dueDate}|${item.completed}|${item.id}').toList();
    await prefs.setStringList(_storageKey, saved);
  }

  Future<void> _addHomework() async {
    final result = await showDialog<_HomeworkData>(
      context: context,
      builder: (_) => const _AddHomeworkDialog(),
    );
    if (result == null) return;
    setState(() => homeworks.insert(0, result));
    await _saveHomeworks();
  }

  Future<void> _toggleHomework(int index) async {
    setState(() {
      homeworks[index].completed = !homeworks[index].completed;
    });
    await _saveHomeworks();
  }

  Future<void> _deleteHomework(int index) async {
    final removed = homeworks[index];
    setState(() => homeworks.removeAt(index));
    await _saveHomeworks();
    if (!mounted) return;
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text('ØªÙ… Ø­Ø°Ù ÙˆØ§Ø¬Ø¨ ${removed.title}')),
    );
  }

  String _formatDate(String value) {
    if (value.isEmpty) return '';
    final date = DateTime.tryParse(value);
    if (date == null) return value;
    return '${date.day.toString().padLeft(2, '0')}/'
        '${date.month.toString().padLeft(2, '0')}/${date.year}';
  }

  Widget _buildEmptyState() {
    return Center(
      child: Padding(
        padding: const EdgeInsets.all(30),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Container(
              width: 95,
              height: 95,
              decoration: const BoxDecoration(
                color: Color(0xFFEFF6FF),
                shape: BoxShape.circle,
              ),
              child: const Icon(Icons.assignment_outlined,
                  color: Color(0xFF2563EB), size: 48),
            ),
            const SizedBox(height: 20),
            const Text('Ù…Ø§ Ø¹Ù†Ø¯Ùƒ ÙˆØ§Ø¬Ø¨Ø§Øª Ø­Ø§Ù„ÙŠØ§Ù‹',
                style: TextStyle(fontSize: 21, fontWeight: FontWeight.bold)),
            const SizedBox(height: 8),
            const Text(
              'Ø£Ø¶Ù ÙˆØ§Ø¬Ø¨Ùƒ Ø§Ù„Ø£ÙˆÙ„ Ø­ØªÙ‰ ØªØªØ§Ø¨Ø¹Ù‡ ÙˆØªØ¹Ø±Ù Ù…ÙˆØ¹Ø¯ ØªØ³Ù„ÙŠÙ…Ù‡.',
              textAlign: TextAlign.center,
              style: TextStyle(color: Colors.grey, height: 1.5),
            ),
            const SizedBox(height: 22),
            FilledButton.icon(
              onPressed: _addHomework,
              icon: const Icon(Icons.add),
              label: const Text('Ø¥Ø¶Ø§ÙØ© ÙˆØ§Ø¬Ø¨'),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildSummary() {
    final completed = homeworks.where((item) => item.completed).length;
    final remaining = homeworks.length - completed;
    return Row(
      children: [
        Expanded(child: _HomeworkSummaryCard(title: 'ÙƒÙ„ Ø§Ù„ÙˆØ§Ø¬Ø¨Ø§Øª', value: '${homeworks.length}', icon: Icons.assignment)),
        const SizedBox(width: 10),
        Expanded(child: _HomeworkSummaryCard(title: 'Ø§Ù„Ù…ØªØ¨Ù‚ÙŠ', value: '$remaining', icon: Icons.pending_actions)),
        const SizedBox(width: 10),
        Expanded(child: _HomeworkSummaryCard(title: 'Ø§Ù„Ù…ÙƒØªÙ…Ù„', value: '$completed', icon: Icons.check_circle_outline)),
      ],
    );
  }

  @override
  Widget build(BuildContext context) {
    return Directionality(
      textDirection: TextDirection.rtl,
      child: Scaffold(
        appBar: AppBar(
          title: const Text('Ø§Ù„ÙˆØ§Ø¬Ø¨Ø§Øª', style: TextStyle(fontWeight: FontWeight.bold)),
          actions: [
            IconButton(
              onPressed: _addHomework,
              icon: const Icon(Icons.add),
              tooltip: 'Ø¥Ø¶Ø§ÙØ© ÙˆØ§Ø¬Ø¨',
            ),
          ],
        ),
        body: loading
            ? const Center(child: CircularProgressIndicator())
            : homeworks.isEmpty
            ? _buildEmptyState()
            : ListView(
          padding: const EdgeInsets.all(18),
          children: [
            _buildSummary(),
            const SizedBox(height: 18),
            ...List.generate(
              homeworks.length,
                  (index) {
                final item = homeworks[index];
                return _HomeworkItem(
                  subject: item.subject,
                  title: item.title,
                  dueDate: _formatDate(item.dueDate),
                  completed: item.completed,
                  onChanged: (_) => _toggleHomework(index),
                  onDelete: () => _deleteHomework(index),
                );
              },
            ),
          ],
        ),
      ),
    );
  }
}

