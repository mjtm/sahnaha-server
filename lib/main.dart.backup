class AppStart extends StatefulWidget {
  const AppStart({super.key});

  @override
  State<AppStart> createState() => _AppStartState();
}

class _AppStartState extends State<AppStart> {
  bool loading = true;
  bool loggedIn = false;

  static const String currentAppVersion = '1.0.0+1';

  @override
  void initState() {
    super.initState();
    _checkLogin();
  }

  Future<void> _checkLogin() async {
    final prefs = await SharedPreferences.getInstance();
    final token = prefs.getString('auth_token');
    final savedScale = prefs.getDouble('ui_scale') ?? 1.0;

    uiScaleNotifier.value = savedScale;

    if (!mounted) return;

    setState(() {
      loggedIn = token != null && token.isNotEmpty;
      loading = false;
    });

    // ÙØ­Øµ ÙˆØ¬ÙˆØ¯ ØªØ­Ø¯ÙŠØ« Ø¨Ø¹Ø¯ ØªØ´ØºÙŠÙ„ Ø§Ù„ØªØ·Ø¨ÙŠÙ‚
    _checkForUpdate();
  }

  Future<void> _checkForUpdate() async {
    try {
      final response = await http
          .get(
        Uri.parse(
          'https://sahnaha-server.vercel.app/api/update',
        ),
      )
          .timeout(const Duration(seconds: 10));

      if (response.statusCode != 200) return;

      final data = jsonDecode(response.body);

      final latestVersion =
          data['latestVersion']?.toString() ?? '';

      final downloadUrl =
          data['downloadUrl']?.toString() ?? '';

      if (!mounted ||
          latestVersion.isEmpty ||
          downloadUrl.isEmpty ||
          latestVersion == currentAppVersion) {
        return;
      }

      await showDialog(
        context: context,
        barrierDismissible: false,
        builder: (context) {
          return AlertDialog(
            title: Text(
              data['title']?.toString() ??
                  'ØªØ­Ø¯ÙŠØ« Ø¬Ø¯ÙŠØ¯ Ù…ØªÙˆÙØ±',
            ),
            content: Text(
              data['message']?.toString() ??
                  'Ø£ÙƒÙˆ ØªØ­Ø¯ÙŠØ« Ø¬Ø¯ÙŠØ¯ Ù„Ù„ØªØ·Ø¨ÙŠÙ‚.',
            ),
            actions: [
              TextButton(
                onPressed: () {
                  Navigator.pop(context);
                },
                child: const Text('Ù„Ø§Ø­Ù‚Ù‹Ø§'),
              ),
              ElevatedButton(
                onPressed: () async {
                  final uri = Uri.parse(downloadUrl);

                  if (await canLaunchUrl(uri)) {
                    await launchUrl(
                      uri,
                      mode: LaunchMode.externalApplication,
                    );
                  }
                },
                child: const Text('ØªØ­Ø¯ÙŠØ« Ø§Ù„Ø¢Ù†'),
              ),
            ],
          );
        },
      );
    } catch (_) {
      // Ø¥Ø°Ø§ Ù…Ø§ÙƒÙˆ Ø¥Ù†ØªØ±Ù†ØªØŒ Ø§Ù„ØªØ·Ø¨ÙŠÙ‚ ÙŠØ´ØªØºÙ„ Ø·Ø¨ÙŠØ¹ÙŠ.
    }
  }

  @override
  Widget build(BuildContext context) {
    if (loading) {
      return const Scaffold(
        body: Center(
          child: CircularProgressIndicator(),
        ),
      );
    }

    return loggedIn
        ? const HomePage()
        : const LoginPage();
  }
}
// Ø¹Ù†ÙˆØ§Ù† Ø§Ù„Ø³ÙŠØ±ÙØ± Ù„Ù„Ø­Ø³Ø§Ø¨Ø§Øª.
// Ù†ÙØ³ Ø¯ÙˆÙ…ÙŠÙ† Vercel Ø§Ù„Ù…Ø³ØªØ®Ø¯Ù… Ù„Ù„Ù…Ø³Ø§Ø¹Ø¯ Ø§Ù„Ø°ÙƒÙŠ.
const String authBaseUrl = 'https://sahnaha-server.vercel.app/api';

