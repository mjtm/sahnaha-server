  int currentQuestion = 0;
  int score = 0;
  int? selectedAnswer;
  bool answered = false;

  void selectAnswer(int index) {
    if (answered) return;

    setState(() {
      selectedAnswer = index;
      answered = true;

      if (index == questions[currentQuestion].correctAnswer) {
        score++;
      }
    });
  }

  void nextQuestion() {
    if (currentQuestion < questions.length - 1) {
      setState(() {
        currentQuestion++;
        selectedAnswer = null;
        answered = false;
      });
    } else {
      _showResult();
    }
  }

  void _restartQuiz() {
    setState(() {
      currentQuestion = 0;
      score = 0;
      selectedAnswer = null;
      answered = false;
    });
  }

  void _showResult() {
    final percent = ((score / questions.length) * 100).round();

    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (dialogContext) {
        return AlertDialog(
          title: const Text(
            'ðŸŽ‰ Ø§Ù†ØªÙ‡Ù‰ Ø§Ù„Ø§Ø®ØªØ¨Ø§Ø±',
            textAlign: TextAlign.center,
          ),
          content: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              const Text('Ù†ØªÙŠØ¬ØªÙƒ'),
              const SizedBox(height: 10),
              Text(
                '$score / ${questions.length}',
                style: const TextStyle(
                  fontSize: 32,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const SizedBox(height: 6),
              Text('$percent / 100'),
            ],
          ),
          actions: [
            TextButton(
              onPressed: () {
                Navigator.pop(dialogContext);
                Navigator.pop(context);
              },
              child: const Text('Ø¥Ù†Ù‡Ø§Ø¡'),
            ),
            FilledButton(
              onPressed: () {
                Navigator.pop(dialogContext);
                _restartQuiz();
              },
              child: const Text('Ø¥Ø¹Ø§Ø¯Ø© Ø§Ù„Ø§Ø®ØªØ¨Ø§Ø±'),
            ),
          ],
        );
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    final question = questions[currentQuestion];

    return Directionality(
      textDirection: TextDirection.rtl,
      child: Scaffold(
        appBar: AppBar(
          title: const Text(
            'Ø§Ø®ØªØ¨Ø± Ù†ÙØ³Ùƒ',
            style: TextStyle(fontWeight: FontWeight.bold),
          ),
        ),
        body: ListView(
          padding: const EdgeInsets.all(18),
          children: [
            Container(
              padding: const EdgeInsets.all(20),
              decoration: BoxDecoration(
                color: const Color(0xFFF3E8FF),
                borderRadius: BorderRadius.circular(22),
              ),
              child: Column(
                children: [
                  Text(
                    'Ø§Ù„Ø³Ø¤Ø§Ù„ ${currentQuestion + 1} Ù…Ù† ${questions.length}',
                    style: const TextStyle(
                      color: Color(0xFF7C3AED),
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  const SizedBox(height: 12),
                  LinearProgressIndicator(
                    value: (currentQuestion + 1) / questions.length,
                    minHeight: 7,
                    borderRadius: BorderRadius.circular(10),
                  ),
                ],
              ),
            ),
            const SizedBox(height: 18),
            Card(
              elevation: 0,
              shape: RoundedRectangleBorder(
                borderRadius: BorderRadius.circular(20),
                side: const BorderSide(color: Color(0xFFE2E8F0)),
              ),
              child: Padding(
                padding: const EdgeInsets.all(20),
                child: Text(
                  question.question,
                  textAlign: TextAlign.right,
                  style: const TextStyle(
                    fontSize: 21,
                    fontWeight: FontWeight.bold,
                    height: 1.5,
                  ),
                ),
              ),
            ),
            const SizedBox(height: 18),
            ...List.generate(
              question.options.length,
                  (index) {
                final isSelected = selectedAnswer == index;
                final isCorrect = index == question.correctAnswer;

                Color? background;
                IconData? icon;

                if (answered && isCorrect) {
                  background = const Color(0xFFD1FAE5);
                  icon = Icons.check_circle;
                } else if (answered && isSelected) {
                  background = const Color(0xFFFEE2E2);
                  icon = Icons.cancel;
                }

                return Card(
                  color: background,
                  elevation: 0,
                  margin: const EdgeInsets.only(bottom: 12),
                  shape: RoundedRectangleBorder(
                    borderRadius: BorderRadius.circular(16),
                    side: const BorderSide(color: Color(0xFFE2E8F0)),
                  ),
                  child: ListTile(
                    contentPadding: const EdgeInsets.symmetric(
                      horizontal: 16,
                      vertical: 6,
                    ),
                    leading: CircleAvatar(
                      child: Text(
                        String.fromCharCode(65 + index),
                      ),
                    ),
                    title: Text(
                      question.options[index],
                      style: const TextStyle(fontSize: 17),
                    ),
                    trailing: icon == null
                        ? null
                        : Icon(icon),
                    onTap: answered
                        ? null
                        : () => selectAnswer(index),
                  ),
                );
              },
            ),
            const SizedBox(height: 8),
            if (answered)
              FilledButton.icon(
                onPressed: nextQuestion,
                icon: Icon(
                  currentQuestion == questions.length - 1
                      ? Icons.emoji_events
                      : Icons.arrow_back,
                ),
                label: Text(
                  currentQuestion == questions.length - 1
                      ? 'Ø¹Ø±Ø¶ Ø§Ù„Ù†ØªÙŠØ¬Ø©'
                      : 'Ø§Ù„Ø³Ø¤Ø§Ù„ Ø§Ù„ØªØ§Ù„ÙŠ',
                ),
              ),
          ],
        ),
      ),
    );
  }
}


