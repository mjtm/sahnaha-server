  Widget _messageBubble(
      _AssistantMessage message,
      int index,
      ) {
    final isUser = message.isUser;

    return Column(
      crossAxisAlignment:
      isUser ? CrossAxisAlignment.end : CrossAxisAlignment.start,
      children: [
        Align(
          alignment:
          isUser ? Alignment.centerRight : Alignment.centerLeft,
          child: Container(
