                    } else if (action == 'delete') {
                      _deleteGrade(subject);
                    }
                  },
                  itemBuilder: (_) => const [
                    PopupMenuItem(
                      value: 'edit',
                      child: Text('ØªØ¹Ø¯ÙŠÙ„'),
                    ),
                    PopupMenuItem(
                      value: 'delete',
                      child: Text('Ø­Ø°Ù'),
                    ),
                  ],
                ),
            ],
          ),
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    if (loading) {
      return const Scaffold(
        body: Center(
          child: CircularProgressIndicator(),
        ),
      );
    }

    return Directionality(
      textDirection: TextDirection.rtl,
      child: Scaffold(
        appBar: AppBar(
          title: const Text(
            'Ø¯Ø±Ø¬Ø§ØªÙŠ',
            style: TextStyle(fontWeight: FontWeight.bold),
          ),
        ),
        body: subjects.isEmpty
            ? const Center(
          child: Text(
            'Ù„Ù… ÙŠØªÙ… Ø§Ø®ØªÙŠØ§Ø± Ø§Ù„ØµÙ Ø¨Ø¹Ø¯',
            style: TextStyle(
              fontSize: 17,
              color: Colors.grey,
            ),
          ),
        )
            : ListView(
          padding: const EdgeInsets.only(bottom: 30),
          children: [
